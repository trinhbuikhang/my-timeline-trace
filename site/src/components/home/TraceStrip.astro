---
import { getCollection } from 'astro:content';
import Section from '../ui/Section.astro';
import { href, pick, useT, type Lang } from '../../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);

const nodes = (await getCollection('trace'))
  .map((e) => e.data)
  .sort((a, b) => (a.year ?? 9999) - (b.year ?? 9999));
const current = Math.max(...nodes.map((n) => n.year ?? 0));

// Space between nodes grows with the years between them (log scale),
// so the long quiet stretches still feel long.
const weights = nodes.map((n, i) => {
  const next = nodes[i + 1];
  if (!next) return 0;
  const gap = (next.year ?? (n.year ?? 0) + 1) - (n.year ?? 0);
  return 1 + Math.log2(Math.max(gap, 1));
});
---

<Section index="04" title="TRACE" id="trace" voice="story">
  <ol class="trace" data-reveal>
    {nodes.map((n, i) => (
      <li
        class:list={['node', n.kind, { current: n.year === current }]}
        style={`--w:${weights[i]};--i:${i}`}
      >
        <span class="dot" aria-hidden="true"></span>
        <span class="year">{n.year ?? '????'}</span>
        {n.kind !== 'future' && <span class="label">{pick(n.label, lang)}</span>}
        {n.capsule && n.year && (
          <a class="capsule meta" href={href(lang, `trace/${n.year}`)}>{t('trace.capsule')} →</a>
        )}
      </li>
    ))}
  </ol>
  <a class="link all" href={href(lang, 'trace')}>{t('trace.follow')} <span class="arrow" aria-hidden="true">→</span></a>
</Section>

<style>
  .trace { list-style: none; padding: 0; position: relative; display: grid; gap: var(--s-5); padding-left: var(--s-5); }

  /* The line itself — drawn once when the section enters the viewport. */
  .trace::before {
    content: ''; position: absolute; left: 4px; top: 6px; bottom: 6px; width: 1px;
    background: linear-gradient(to bottom, var(--line-strong) 85%, transparent);
    transform-origin: top;
  }
  :global(.js) .trace::before { transform: scaleY(0); transition: transform 1400ms var(--ease-out); }
  :global(.js) .trace:global(.is-in)::before { transform: none; }
  :global(.js) .trace[data-reveal] { opacity: 1; transform: none; }

  .node { position: relative; display: grid; gap: 2px; }
  :global(.js) .node { opacity: 0; transition: opacity 600ms var(--ease-out); transition-delay: calc(200ms + var(--i) * 140ms); }
  :global(.js) .trace:global(.is-in) .node { opacity: 1; }

  .dot {
    position: absolute; left: calc(-1 * var(--s-5)); top: 0.45em;
    width: 9px; height: 9px; background: var(--bg); border: 1px solid var(--text-muted);
  }
  .year { font-family: var(--font-mono); font-size: var(--fs-h3); font-weight: 500; letter-spacing: -0.02em; }
  .label { color: var(--text-muted); }
  .capsule { color: var(--signal); margin-top: var(--s-1); }

  .current .dot { background: var(--signal); border-color: var(--signal); box-shadow: 0 0 0 4px var(--signal-glow); }
  .current .year { color: var(--signal); }
  .turning-point .dot { transform: rotate(45deg); }
  .future .dot { border-style: dashed; }
  .future .year { color: var(--text-faint); }

  .all { margin-top: var(--s-6); }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .trace::before { transform: none; }
    :global(.js) .node { opacity: 1; }
  }

  /* Horizontal on wide screens */
  @media (min-width: 900px) {
    .trace { display: flex; padding: var(--s-6) 0 0; gap: 0; }
    .trace::before {
      left: 0; right: 0; top: calc(var(--s-6) + 4px); bottom: auto; width: auto; height: 1px;
      background: linear-gradient(to right, var(--line-strong) 88%, transparent);
      transform-origin: left;
    }
    :global(.js) .trace::before { transform: scaleX(0); }
    .node { flex: var(--w) 0 0; min-width: 7.5em; padding-top: var(--s-5); padding-right: var(--s-3); }
    .node:last-child { flex: 0 0 auto; }
    .dot { left: 0; top: 0; }
  }
</style>
