---
import Section from '../ui/Section.astro';
import { href, pick, useT, type Lang } from '../../i18n/ui';
import { getNow } from '../../lib/content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
const now = (await getNow()).data;
const groups = [
  ['now.building', now.building],
  ['now.exploring', now.exploring],
  ['now.thinking', now.thinking],
] as const;
---

<Section index="01" title="NOW" meta={`${t('now.updated')} ${now.updated}`} id="now">
  <dl class="cols">
    {groups.map(([key, items], i) => (
      <div class="col" data-reveal style={`--i:${i}`}>
        <dt class="meta">{t(key)}</dt>
        {items.map((it) => <dd>{pick(it, lang)}</dd>)}
      </div>
    ))}
  </dl>
  <div class="question" data-reveal>
    <p class="meta">{t('now.question')}</p>
    <p class="q">“{pick(now.question, lang)}”</p>
    <a class="link" href={href(lang, 'now')}>{t('now.view')} <span class="arrow" aria-hidden="true">→</span></a>
  </div>
</Section>

<style>
  .cols { display: grid; gap: var(--s-5); }
  .col { display: grid; grid-template-columns: 9.5em 1fr; gap: 0 var(--s-4); padding-bottom: var(--s-4); border-bottom: 1px solid var(--line); }
  .col dt { grid-row: span 9; padding-top: 0.35em; }
  .col dd { grid-column: 2; font-size: var(--fs-h3); font-weight: 500; letter-spacing: -0.01em; line-height: 1.35; }

  .question { margin-top: var(--s-7); display: grid; gap: var(--s-3); justify-items: start; }
  .q { font-family: var(--font-serif); font-style: italic; font-size: var(--fs-h2); line-height: 1.25; color: var(--text); }

  @media (min-width: 640px) {
    .cols { grid-template-columns: repeat(3, 1fr); gap: var(--s-6); }
    .col { display: block; border-bottom: 0; border-left: 1px solid var(--line); padding: 0 0 0 var(--s-4); }
    .col dt { margin-bottom: var(--s-4); }
    .col dd + dd { margin-top: var(--s-2); }
  }
</style>
