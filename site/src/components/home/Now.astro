---
import Section from '../ds/Section.astro';
import { pick, tx, type Lang } from '../../i18n/ui';
import { getNow } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const l = tx(lang);
const now = (await getNow()).data;
const groups = [
  { name: l('Đang xây', 'Building'), rows: now.building.map((v, i) => [i ? l('Phụ', 'Secondary') : l('Dự án chính', 'Primary project'), v] as const) },
  { name: l('Đang khám phá', 'Exploring'), rows: now.exploring.map((v) => [l('Lĩnh vực', 'Field'), v] as const) },
  { name: l('Đang nghĩ về', 'Thinking about'), rows: now.thinking.map((v) => [l('Hướng đi', 'Direction'), v] as const) },
];
---

<Section id="now" n={6} title={l('Đặc tính hoạt động — hiện tại', 'Electrical characteristics — now')}>
  <div class="tw meter" data-meter>
    <table>
      <thead><tr><th>{l('Tham số', 'Parameter')}</th><th>{l('Điều kiện', 'Test conditions')}</th><th>{l('Giá trị', 'Value')}</th></tr></thead>
      <tbody>
        {groups.map((g) => (
          <>
            <tr class="grp"><td colspan="3">{g.name}</td></tr>
            {g.rows.map(([param, v]) => (
              <tr><td>{param}</td><td class="m">{now.updated}</td><td class="val" data-reading>{pick(v, lang)}</td></tr>
            ))}
          </>
        ))}
        <tr>
          <td>{l('Câu hỏi mở', 'Open question')}</td><td class="m">—</td>
          <td class="val q"><span data-reading>{pick(now.question, lang)}</span><span class="caret" aria-hidden="true"></span></td>
        </tr>
      </tbody>
    </table>
    <span class="probe" aria-hidden="true"></span>
  </div>
</Section>

<script>
  import '../../scripts/ds/now';
</script>

<style>
  .meter { position: relative; }
  .q { color: var(--accent); }
  /* a probe sweeps the table top to bottom */
  .probe { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--accent); box-shadow: 0 0 0 1px var(--paper); opacity: 0; pointer-events: none; }
  :global(.js #now.on) .probe { animation: sweep 1.3s var(--ease) both; }
  @keyframes sweep { 0% { opacity: 1; transform: translateY(0); } 90% { opacity: 1; } 100% { opacity: 0; transform: translateY(var(--h, 300px)); } }
</style>
