---
import { href, useT, type Lang } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
---

<aside class="support">
  <div class="container inner" data-reveal>
    <p class="meta title">{t('support.title')} <span aria-hidden="true">☕</span></p>
    <p class="line">{t('support.line')}</p>
    <a class="link" href={href(lang, 'support')}>{t('support.cta')} <span class="arrow" aria-hidden="true">→</span></a>
  </div>
</aside>

<style>
  .support { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding-block: var(--s-6); }
  .inner { display: grid; gap: var(--s-3); align-items: center; }
  .title { color: var(--text); }
  .line { color: var(--text-muted); max-width: 52em; font-size: 0.875rem; }
  @media (min-width: 1024px) {
    .inner { grid-template-columns: 4fr 7fr auto; gap: var(--col-gap); }
  }
</style>
