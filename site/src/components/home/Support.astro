---
import Section from '../ds/Section.astro';
import { href, tx, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const l = tx(lang);
// Ordering codes only; the support platform is not chosen yet (EC item), so every row goes to /support/.
const parts = [['PA-COFFEE-1', '☕', '$5'], ['PA-COFFEE-2', '☕☕', '$10'], ['PA-COFFEE-3', '☕☕☕', '$25']];
---

<Section id="support" n={10} title={l('Thông tin đặt hàng — fuel the lab', 'Ordering information — fuel the lab')}>
  <p class="lead">{l(
    'Pharaoh Alone là một dự án độc lập. Nếu điều gì đó ở đây giúp bạn nghĩ, học hay xây, bạn có thể giúp phòng lab có điện để chạy tiếp.',
    'Pharaoh Alone is an independent project. If something here helped you think, learn or build, you can help keep the lab powered.',
  )}</p>
  <div class="rail">
    <svg class="batt" data-batt viewBox="0 0 54 22" aria-hidden="true">
      <rect class="shell" x="1" y="1" width="46" height="20" /><rect class="tip" x="48" y="7" width="4" height="8" />
      <rect class="cell c1" x="4" y="4" width="12" height="14" /><rect class="cell c2" x="18" y="4" width="12" height="14" /><rect class="cell c3" x="32" y="4" width="12" height="14" />
    </svg>
    <span data-vcc>{l('VCC: THẤP', 'VCC: LOW')}</span>
  </div>
  <div class="tw">
    <table class="ord">
      <thead><tr><th>{l('Mã đặt hàng', 'Orderable part')}</th><th>{l('Gói', 'Package')}</th><th>{l('Giá', 'Price')}</th></tr></thead>
      <tbody>
        {parts.map(([code, pkg, price], i) => (
          <tr data-level={i + 1}><td class="m"><a href={href(lang, 'support')}>{code}</a></td><td>{pkg}</td><td class="m">{price}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</Section>

<script>
  import '../../scripts/ds/support';
</script>

<style>
  .lead { margin: 0 0 12px; max-width: 62ch; font-size: 14px; color: var(--ink-2); }
  .ord a { text-decoration: none; font-weight: 700; color: var(--accent); }
  .ord a:hover { text-decoration: underline; }
  .ord tbody tr { transition: background 80ms; }
  .ord tbody tr:hover { background: var(--band); }
  /* the lab's supply rail is low; hovering an order charges it */
  .rail { display: flex; align-items: center; gap: 12px; margin: 0 0 14px; font: 500 12px/1 var(--mono); color: var(--ink-2); }
  .batt { width: 54px; height: 22px; display: block; overflow: visible; }
  .shell { fill: none; stroke: var(--ink); stroke-width: 1.5; }
  .tip { fill: var(--ink); }
  .cell { fill: var(--ink); transition: opacity 120ms; opacity: 0; }
  .c1 { fill: var(--accent); opacity: 1; animation: blink 1.2s steps(2) infinite; }
  .batt[data-charge] .c1 { animation: none; fill: var(--ink); }
  .batt[data-charge='2'] .c2, .batt[data-charge='3'] .c2, .batt[data-charge='3'] .c3 { opacity: 1; }
</style>
