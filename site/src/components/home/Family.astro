---
import { getCollection } from 'astro:content';
import Section from '../ds/Section.astro';
import { pick, tx, useT, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const l = tx(lang);
const t = useT(lang);
const gens = (await getCollection('lineage')).sort((a, b) => a.data.order - b.data.order);
const label = {
  'line-follower': l('Mô phỏng robot dò đường nhìn từ trên, bám theo một vạch kẻ bằng dãy cảm biến', 'Top view of a line-following robot tracking a line with its sensor array'),
  uav: l('Mô phỏng UAV bốn cánh quạt nhìn từ trên, bay lơ lửng', 'Top view of a hovering four-rotor UAV'),
  humanoid: l('Phác thảo robot hình người bằng nét đứt, đầu chứa một mạng nơ-ron gửi tín hiệu xuống các khớp', 'Humanoid robot sketched in phantom lines; a neural network in its head signals the joints'),
};
const steps = [l('+ trục z', '+ z axis'), l('+ AI<br>+ cơ thể', '+ AI<br>+ a body')];
---

<Section id="family" n={4} title={l('Dòng sản phẩm — tiến hoá', 'Product family — evolution')}>
  <div class="family">
    {gens.map(({ id, data }, i) => (
      <>
        {i > 0 && (
          <div class="step" aria-hidden="true">
            <svg viewBox="0 0 40 14"><path d="M0 7 H37 M31 2 L37 7 L31 12" stroke-dasharray={data.status === 'dream' ? '4 3' : undefined} /></svg>
            <span set:html={steps[i - 1]} />
          </div>
        )}
        <figure class:list={['gen', { dream: data.status === 'dream' }]} id={data.status === 'dream' ? 'dream' : id}>
          <canvas data-sim={data.sim} role="img" aria-label={label[data.sim]}></canvas>
          <span class="meta">
            <span class="tag">REV {data.rev}</span>
            <span>{data.code}</span>
            <span>{data.status === 'dream' ? l('ƯỚC MƠ · CHƯA XÁC ĐỊNH', 'DREAM · NOT YET DEFINED') : l('DỰ ÁN SINH VIÊN', 'STUDENT PROJECT')}</span>
          </span>
          <h3>{pick(data.name, lang)}</h3>
          <dl>
            {data.facts.map((f) => (<><dt>{pick(f.k, lang)}</dt><dd>{pick(f.v, lang)}</dd></>))}
            <dt>{l('Năm', 'Year')}</dt>
            <dd class:list={{ ph: data.year === null && data.status !== 'dream' }}>{data.year ?? (data.status === 'dream' ? '—' : t('tbw'))}</dd>
            {data.status === 'dream' ? (
              <><dt>{l('Trạng thái', 'Status')}</dt><dd class="acc">{l('Vẽ bằng nét đứt', 'Drawn in phantom lines')}</dd></>
            ) : (
              <><dt>{l('Ghi chú', 'Note')}</dt><dd class:list={{ ph: !data.note }}>{data.note ? pick(data.note, lang) : l('[Một câu: điều học được]', '[One sentence on what you learned]')}</dd></>
            )}
          </dl>
        </figure>
      </>
    ))}
  </div>
  <p class="note">{l(
    'Từ bám theo một vạch kẻ, đến rời khỏi mặt đất, đến một ngày làm việc cạnh con người. Nét đứt là những phần chưa tồn tại.',
    'From following a line, to leaving the ground, to someday working beside people. Phantom lines mark parts that do not exist yet.',
  )}</p>
</Section>

<script>
  import '../../scripts/ds/family';
</script>

<style>
  .family { display: grid; grid-template-columns: 1fr; gap: 18px; }
  .gen { display: grid; gap: 10px; align-content: start; }
  .gen canvas { width: 100%; aspect-ratio: 4 / 3; display: block; border: 1px solid var(--rule); background: var(--paper); }
  .dream canvas { background-image: repeating-linear-gradient(45deg, transparent 0 7px, var(--band) 7px 8.5px); }
  .meta { display: flex; flex-wrap: wrap; gap: 2px 12px; font: 500 11.5px/1.3 var(--mono); color: var(--ink-2); }
  .tag { color: var(--paper); background: var(--ink); padding: 1px 6px; }
  .dream .tag { background: none; color: var(--accent); border: 1px dashed var(--accent); }
  h3 { margin: 0; font: 800 26px/1.05 var(--body); font-stretch: 78%; text-transform: uppercase; letter-spacing: 0.01em; }
  dl { margin: 0; display: grid; grid-template-columns: auto 1fr; font-size: 13.5px; border-top: 1px solid var(--rule); }
  dt, dd { margin: 0; padding: 5px 0; border-bottom: 1px solid var(--rule); }
  dt { color: var(--ink-2); padding-right: 14px; }
  dd { font-weight: 600; }
  dd.ph { font-weight: 400; }
  dd.acc { color: var(--accent); }
  .step { display: none; }
  .note { margin-top: 14px; max-width: 70ch; }
  :global(.js) .gen { transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); }
  :global(.js #family:not(.on)) .gen { opacity: 0; transform: translateY(24px); }
  .gen:nth-of-type(2) { transition-delay: 0.18s; }
  .gen:nth-of-type(3) { transition-delay: 0.36s; }

  @media (min-width: 900px) {
    .family { grid-template-columns: minmax(0, 1fr) 68px minmax(0, 1fr) 68px minmax(0, 1fr); gap: 0; }
    .step { display: grid; justify-items: center; align-content: start; padding-top: 18%; gap: 6px; font: 600 11px/1.2 var(--mono); color: var(--accent); text-align: center; }
    .step svg { width: 40px; height: 14px; overflow: visible; }
    .step path { fill: none; stroke: var(--accent); stroke-width: 1.5; }
  }
</style>
