---
import { getCollection } from 'astro:content';
import { pick, useT, type Lang } from '../../i18n/ui';
import { getArchiveStats } from '../../lib/content';
import { LAND_POINTS_COUNT } from '../../lib/globe-meta';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);

const fmt = (lat: number, lon: number) =>
  `${Math.abs(lat).toFixed(2)}°${lat >= 0 ? 'N' : 'S'} ${Math.abs(lon).toFixed(2)}°${lon >= 0 ? 'E' : 'W'}`;

const placeEntries = await getCollection('places');
const places = placeEntries.map(({ id, data }) => ({
  id,
  name: pick(data.name, lang),
  lat: data.lat,
  lon: data.lon,
  label: `${data.precision === 'country' ? '≈ ' : ''}${fmt(data.lat, data.lon)}${data.since ? ` · ${data.since}` : ''}`,
}));

const trace = (await getCollection('trace')).map((e) => e.data.year).filter((y): y is number => y !== null);
const stats = await getArchiveStats();
const n = (x: number) => x.toLocaleString('en-US');

const boot = [
  'INIT ORTHOGRAPHIC · WGS84',
  `LOAD LAND · ${n(LAND_POINTS_COUNT)} PTS`,
  `PLOT PLACES · ${places.length}`,
  `TRACE ${Math.min(...trace)} → ${Math.max(...trace)}`,
  `ENTRIES · ${stats.systems} SYS · ${stats.stories} STR · ${stats.capsules} CAP`,
  'READY',
];
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <script is:inline>
    (function () {
      var hero = document.currentScript.parentElement, seen = false;
      try { seen = sessionStorage.getItem('pa-boot') === '1'; sessionStorage.setItem('pa-boot', '1'); } catch (e) {}
      if (!seen && !matchMedia('(prefers-reduced-motion: reduce)').matches) hero.classList.add('animate');
      else hero.classList.add('is-ready');
    })();
  </script>

  <div class="globe-wrap">
    <canvas
      class="globe"
      tabindex="0"
      role="img"
      aria-label={t('globe.label')}
      data-places={JSON.stringify(places)}
    ></canvas>
  </div>

  <div class="container content">
    <p class="meta hero-meta">
      <span>ARCHIVE № 001</span>
      <span>SINCE 1992</span>
      <span class="rec"><i aria-hidden="true"></i>{t('recording')}</span>
    </p>

    <h1 class="title" id="hero-title">
      <span class="line"><span>PHARAOH</span></span>
      <span class="line"><span>ALONE</span></span>
    </h1>

    <p class="tagline">
      <span class="line"><span>{t('tagline.1')}</span></span>
      <span class="line"><span>{t('tagline.2')}</span></span>
      <span class="line"><span>{t('tagline.3')}<span class="cursor" aria-hidden="true"></span></span></span>
    </p>

    <div class="readout meta" aria-hidden="true">
      <ol class="boot">
          {boot.map((line, i) => <li style={`--i:${i}`}>&gt; {line}</li>)}
        </ol>
        <dl class="live">
          <div><dt>CENTER</dt><dd data-center>—</dd></div>
          <div class="wide"><dt>PROJ</dt><dd>ORTHOGRAPHIC · WGS84</dd></div>
          <div class="wide"><dt>LAND</dt><dd>{n(LAND_POINTS_COUNT)} PTS</dd></div>
          <div><dt>↻</dt><dd>{t('globe.drag')}</dd></div>
        </dl>
      </div>

    <div class="foot">
      <p class="meta disciplines">
        {['ENGINEERING', 'DATA', 'GIS', 'SOFTWARE', 'AI'].map((d, i) => (
          <>{i > 0 && <span class="x" aria-hidden="true">×</span>}<span>{d}</span></>
        ))}
      </p>
      <a class="enter meta" href="#now">[ {t('enter')} <span aria-hidden="true">↓</span> ]</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 61px);
    display: flex; flex-direction: column;
    overflow: hidden;
    isolation: isolate;
  }

  /* Dot grid: a survey sheet behind everything */
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -2;
    background-image: radial-gradient(circle at 1px 1px, rgb(236 233 226 / 0.07) 1px, transparent 0);
    background-size: 24px 24px;
    mask-image: radial-gradient(120% 90% at 70% 45%, #000 30%, transparent 85%);
  }

  /* ---------- Globe ---------- */
  .globe-wrap {
    position: relative;
    width: 128vw; max-width: 720px;
    aspect-ratio: 1;
    margin: -8vw -14vw -26vw auto;
    z-index: -1;
  }
  .globe { width: 100%; height: 100%; cursor: grab; touch-action: pan-y; }
  .globe[data-dragging] { cursor: grabbing; }
  .globe:focus-visible { outline-offset: -40px; border-radius: 50%; }

  .readout {
    position: absolute; right: var(--gutter); top: var(--s-4);
    font-size: 0.625rem; line-height: 1.7; color: var(--text-muted);
    pointer-events: none;
  }
  .readout dl div:not(:first-child) { display: none; }
  .readout ol { list-style: none; padding: 0; }
  .readout dl div { display: flex; gap: var(--s-3); }
  .readout dt { color: var(--text-faint); min-width: 4.5em; }
  .readout dd { color: var(--text); }
  .live { display: none; }
  .is-ready .boot { display: none; }
  .is-ready .live { display: block; animation: fade 600ms var(--ease-out) both; }

  /* ---------- Text ---------- */
  .content {
    flex: 1;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding-block: 0 var(--s-6);
  }
  .hero-meta { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); }
  .rec { display: inline-flex; align-items: center; gap: var(--s-2); color: var(--signal); }
  .rec i { width: 6px; height: 6px; border-radius: 50%; background: var(--signal); animation: rec 2.4s ease-in-out infinite; }

  .title {
    margin-top: var(--s-4);
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: 0.84;
    letter-spacing: -0.045em;
    text-shadow: 0 0 40px var(--bg);
  }

  .tagline {
    margin-top: var(--s-6);
    font-family: var(--font-serif);
    font-size: var(--fs-h2);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .tagline .line:nth-child(3) span { font-style: italic; color: var(--signal); }

  .line { display: block; overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .line > span { display: inline-block; }

  .cursor {
    display: inline-block; width: 0.5em; height: 0.08em; margin-left: 0.1em;
    background: currentColor; vertical-align: baseline;
    animation: blink 1.1s steps(1) 9 both;
  }

  .foot {
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-4);
  }
  .disciplines { display: flex; flex-wrap: wrap; gap: var(--s-2); color: var(--text); }
  .x { color: var(--signal); }
  .enter {
    color: var(--text); border: 1px solid var(--line-strong);
    padding: var(--s-3) var(--s-4); min-height: 44px; display: inline-flex; align-items: center; gap: var(--s-2);
    transition: background var(--t-snap), color var(--t-snap), border-color var(--t-snap);
  }
  .enter:hover { background: var(--signal); color: var(--bg); border-color: var(--signal); }
  .enter span { display: inline-block; transition: transform var(--t-base) var(--ease-out); }
  .enter:hover span { transform: translateY(3px); }

  /* ---------- Desktop ---------- */
  @media (min-width: 1024px) {
    .globe-wrap {
      position: absolute; margin: 0;
      width: min(64vw, 112svh, 980px);
      right: max(-8vw, calc((100vw - var(--max)) / -2 - 4vw));
      top: 50%; transform: translateY(-52%);
    }
    .readout {
      position: static; align-self: flex-end; margin-top: var(--s-7);
      min-width: 21em; min-height: 7em; font-size: var(--fs-meta);
    }
    .readout dl div:not(:first-child) { display: flex; }
    .content { justify-content: center; padding-block: var(--s-9) var(--s-7); }
    .title { margin-top: var(--s-5); }
    .tagline { max-width: 14em; }
    .foot { margin-top: var(--s-4); }
  }

  /* ---------- Intro (first visit in a session only) ---------- */
  .animate .title .line > span { animation: rise 1100ms var(--ease-out) both; }
  .animate .title .line:nth-child(2) > span { animation-delay: 120ms; }
  .animate .tagline .line > span { animation: rise 1300ms var(--ease-out) both; }
  .animate .tagline .line:nth-child(1) > span { animation-delay: 650ms; }
  .animate .tagline .line:nth-child(2) > span { animation-delay: 820ms; }
  .animate .tagline .line:nth-child(3) > span { animation-delay: 990ms; }
  .animate .hero-meta, .animate .foot { animation: fade 900ms var(--ease-out) 1300ms both; }
  .animate .boot li { animation: type 10ms linear both; animation-delay: calc(200ms + var(--i) * 230ms); }

  @keyframes rise { from { transform: translateY(105%); } }
  @keyframes fade { from { opacity: 0; } }
  @keyframes type { from { visibility: hidden; } }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes rec { 50% { opacity: 0.25; } }

  @media (prefers-reduced-motion: reduce) {
    .rec i, .cursor { animation: none; }
  }
</style>

<script>
  import { createGlobe, formatCoord } from '../../scripts/globe';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('canvas')!;
  const centerEl = hero.querySelector<HTMLElement>('[data-center]')!;

  createGlobe({
    canvas,
    places: JSON.parse(canvas.dataset.places ?? '[]'),
    reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
    animateIntro: hero.classList.contains('animate'),
    onCenter: (lat, lon) => (centerEl.textContent = formatCoord(lat, lon)),
    onReady: () => hero.classList.add('is-ready'),
  });
</script>
