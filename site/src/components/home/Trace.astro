---
import { getCollection } from 'astro:content';
import Section from '../ds/Section.astro';
import { href, pick, tx, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const l = tx(lang);
const nodes = (await getCollection('trace')).map((e) => e.data);
const known = nodes.filter((n): n is typeof n & { year: number } => n.year !== null).sort((a, b) => a.year - b.year);
const marks = known.map((n) => ({ year: n.year, label: pick(n.label, lang) }));
const REV = '*ABCDEFGHJKLMNPRTUVWY';
---

<Section id="trace" n={9} title={l('Lịch sử sửa đổi — dấu vết', 'Revision history — trace')}>
  <figure class="timing">
    <svg
      data-timing
      data-marks={JSON.stringify(marks)}
      data-future={l('tương lai', 'future')}
      role="img"
      aria-label={l('Giản đồ thời gian các mốc ', 'Timing diagram of the milestones ') + known.map((n) => n.year).join(', ') + l(' và tương lai chưa xác định', ' and an undefined future')}
    ></svg>
    <figcaption><b>{l('Hình 4.', 'Figure 4.')}</b> {l('Giản đồ thời gian. Phần gạch chéo = chưa xác định. Rê chuột để đọc năm.', 'Timing diagram. Hatched = not yet defined. Hover to read the year.')}</figcaption>
  </figure>
  <div class="tw rev">
    <table>
      <thead><tr><th>Rev</th><th>{l('Ngày', 'Date')}</th><th>{l('Thay đổi', 'Changes')}</th></tr></thead>
      <tbody>
        {known.map((n, i) => (
          <tr class:list={{ cur: i === known.length - 1 }}>
            <td class="r">{REV[i]}</td>
            <td class="m">{n.year}</td>
            <td>
              {i === 0 ? l('Phát hành lần đầu · ', 'Initial release · ') : ''}{pick(n.label, lang)}
              {n.capsule && <> · <a href={href(lang, 'trace')}>capsule {n.year}</a></>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Section>

<script>
  import '../../scripts/ds/timing';
</script>

<style>
  .timing { overflow-x: auto; }
  .timing svg { width: 100%; min-width: 680px; height: auto; display: block; overflow: visible; cursor: crosshair; }
  .timing figcaption { position: sticky; left: 0; }
  .timing :global(.ln) { fill: none; stroke: var(--ink); stroke-width: 1.4; }
  .timing :global(.x) { fill: url(#hatch); stroke: none; }
  .timing :global(text) { font: 600 12.5px var(--body); fill: var(--ink); }
  .timing :global(.yr) { font: 500 11px var(--mono); fill: var(--ink-2); }
  .timing :global(.cur) { stroke: var(--accent); }
  .timing :global(.curt) { fill: var(--accent); }
  .timing :global(.tick) { stroke: var(--rule); stroke-dasharray: 2 3; }
  .timing :global(.cursor line) { stroke: var(--accent); stroke-width: 1; }
  .timing :global(.cursor rect) { fill: var(--accent); }
  .timing :global(.cursor text) { fill: var(--paper); font: 600 11px var(--mono); }
  .timing :global(.head) { stroke: var(--accent); stroke-width: 1.5; }
  .rev { margin-top: 20px; }
  .r { font: 700 14px var(--mono); width: 60px; }
  .cur .r, .rev a { color: var(--accent); }
</style>
