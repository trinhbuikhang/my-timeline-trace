---
import { getCollection } from 'astro:content';
import Section from '../ui/Section.astro';
import StatusBadge from '../ui/StatusBadge.astro';
import { href, pick, useT, type Lang } from '../../i18n/ui';
import { archiveId, getSystems } from '../../lib/content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);

const systems = (await getSystems(lang)).filter(({ entry }) => entry.data.featured).slice(0, 4);
const professional = await getCollection('professional');
const nextId = archiveId('SYS', systems.length + 1);
---

<Section index="02" title="SYSTEMS" id="systems" voice="system">
  <p slot="aside" class="identity" data-reveal>{t('identity')}</p>

  <p class="meta group">{t('systems.personal')}</p>
  <ol class="rows">
    {systems.map(({ entry, fallback }, i) => (
      <li data-reveal style={`--i:${i}`}>
        <a class="row" href={href(lang, `systems/${entry.data.translationKey}`)}>
          <span class="id meta">{archiveId('SYS', i + 1)}</span>
          <span class="name">{entry.data.title}</span>
          <span class="status"><StatusBadge status={entry.data.status} tone="signal" /></span>
          <span class="year meta">{entry.data.year ?? '····'}</span>
          <span class="go" aria-hidden="true">→</span>
          <span class="problem">
            <span class="meta">{t('systems.problem')}</span>
            <span class:list={[{ ph: entry.data.placeholder }]}>{entry.data.problem}</span>
            {fallback && <span class="meta">· {t('vionly')}</span>}
          </span>
        </a>
      </li>
    ))}
    <li data-reveal style={`--i:${systems.length}`}>
      <div class="row reserved" aria-label={t('systems.next')}>
        <span class="id meta">{nextId}</span>
        <span class="name">????</span>
        <span class="status"><StatusBadge status="IDEA" /></span>
        <span class="year meta">20··</span>
        <span class="go" aria-hidden="true"></span>
        <span class="problem"><span class="meta">{t('systems.next')}</span></span>
      </div>
    </li>
  </ol>

  <a class="link all" href={href(lang, 'systems')}>{t('systems.all')} <span class="arrow" aria-hidden="true">→</span></a>

  <div class="pro" data-reveal>
    <p class="meta group">{t('systems.professional')}</p>
    <ul>
      {professional.map(({ data }) => (
        <li>
          <p class="pro-title">{pick(data.title, lang)}</p>
          <p class="pro-sum">{pick(data.summary, lang)}</p>
        </li>
      ))}
    </ul>
    <p class="meta note">{t('systems.professional.note')}</p>
  </div>
</Section>

<style>
  .identity {
    margin-top: var(--s-5);
    font-size: var(--fs-h3); font-weight: 600; letter-spacing: -0.015em; line-height: 1.25;
    max-width: 14em;
  }
  .group { margin-bottom: var(--s-3); }

  .rows { list-style: none; padding: 0; border-top: 1px solid var(--line-strong); }
  .rows li { border-bottom: 1px solid var(--line-strong); }

  /* System voice: fast, strong, sharp. */
  .row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'id status go' 'name name name' 'problem problem problem';
    gap: var(--s-2) var(--s-4);
    align-items: center;
    padding: var(--s-4) var(--s-2);
    isolation: isolate;
    transition: color var(--t-snap) var(--ease-snap);
  }
  .row::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--text);
    transform: scaleX(0); transform-origin: left;
    transition: transform 180ms var(--ease-snap);
  }
  .id { grid-area: id; }
  .name {
    grid-area: name;
    font-size: var(--fs-h2); font-weight: 800; letter-spacing: -0.03em; line-height: 1;
    text-transform: uppercase;
  }
  .status { grid-area: status; justify-self: end; }
  .year { display: none; }
  .go { grid-area: go; font-family: var(--font-mono); transition: transform var(--t-snap) var(--ease-snap); }
  .problem { grid-area: problem; display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-3); font-size: var(--fs-ui); color: var(--text-muted); }
  .ph { font-style: italic; }

  a.row:hover, a.row:focus-visible { color: var(--bg); }
  a.row:hover::before, a.row:focus-visible::before { transform: scaleX(1); }
  a.row:hover :is(.meta, .problem), a.row:focus-visible :is(.meta, .problem) { color: var(--bg); }
  a.row:hover :global(.badge), a.row:focus-visible :global(.badge) { color: var(--bg); border-color: var(--bg); }
  a.row:hover .go { transform: translateX(6px); }

  .reserved .name { color: var(--text-faint); letter-spacing: 0.1em; }

  .all { margin-top: var(--s-5); }

  .pro { margin-top: var(--s-8); }
  .pro ul { list-style: none; padding: 0; display: grid; gap: var(--s-4); border-top: 1px solid var(--line); padding-top: var(--s-4); }
  .pro-title { font-family: var(--font-mono); font-size: 0.8125rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .pro-sum { color: var(--text-muted); margin-top: 2px; }
  .note { margin-top: var(--s-4); color: var(--text-faint); }

  @media (min-width: 640px) {
    .pro ul { grid-template-columns: 1fr 1fr; gap: var(--s-5) var(--s-6); }
  }

  @media (min-width: 1024px) {
    .row {
      grid-template-columns: 7.5em 1fr auto 4em 1.5em;
      grid-template-areas: 'id name status year go' '. problem problem problem problem';
      row-gap: 0;
      padding: var(--s-5) var(--s-3);
    }
    .year { display: block; grid-area: year; text-align: right; }
    /* Problem line is revealed on hover/focus on large screens. */
    .problem { max-height: 0; overflow: hidden; opacity: 0; transition: max-height var(--t-base) var(--ease-snap), opacity var(--t-snap), margin var(--t-base) var(--ease-snap); }
    a.row:hover .problem, a.row:focus-visible .problem { max-height: 4em; opacity: 1; margin-top: var(--s-3); }
  }
</style>
