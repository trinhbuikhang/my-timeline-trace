---
import LangSwitch from './LangSwitch.astro';
import { SECONDARY_NAV, href, useT, type Lang } from '../i18n/ui';
import { getArchiveStats } from '../lib/content';

interface Props { lang: Lang; alternate: string; }
const { lang, alternate } = Astro.props;
const t = useT(lang);
const stats = await getArchiveStats();
const built = new Date().toISOString().slice(0, 10);
---

<footer class="footer">
  <div class="container">
    <div class="top">
      <p class="sign">PHARAOH ALONE <span class="meta">· 1992 → ∞</span></p>
      <nav class="links" aria-label="Secondary">
        {SECONDARY_NAV.map((s) => <a class="link" href={href(lang, s)}>{s.toUpperCase()}</a>)}
        <LangSwitch lang={lang} alternate={alternate} />
      </nav>
    </div>
    <p class="stats meta">
      <span>ARCHIVE</span>
      <span>{stats.stories} {t('stats.stories')}</span>
      <span>{stats.systems} {t('stats.systems')}</span>
      <span>{stats.capsules} {t('stats.capsules')}</span>
      <span>{t('stats.updated')} {built}</span>
    </p>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-block: var(--s-7) var(--s-6); margin-top: var(--s-9); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-5); }
  .sign { font-weight: 700; letter-spacing: 0.16em; font-size: 0.875rem; }
  .links { display: flex; flex-wrap: wrap; gap: var(--s-5); align-items: center; }
  .stats { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); margin-top: var(--s-6); color: var(--text-faint); }
  .stats span:first-child { color: var(--text-muted); }
</style>
