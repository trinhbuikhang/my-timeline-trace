---
import { SECONDARY_NAV, href, useT, type Lang } from '../../i18n/ui';
import { getArchiveStats } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const stats = await getArchiveStats();
const count = (n: number, key: Parameters<typeof t>[0]) => `${n} ${n === 1 && lang === 'en' ? t(key).replace(/ies$/, 'y').replace(/s$/, '') : t(key)}`;
---

<footer class="foot">
  <span>PASLV001 · Pharaoh Alone · 1992 → ∞</span>
  <nav aria-label="Secondary">{SECONDARY_NAV.map((s) => <a href={href(lang, s)}>{s.toUpperCase()}</a>)}</nav>
  <span>{count(stats.stories, 'stats.stories')} · {count(stats.systems, 'stats.systems')} · {count(stats.capsules, 'stats.capsules')}</span>
  <span>{t('foot.revising')}</span>
</footer>

<style>
  .foot { margin-top: 40px; padding-top: 10px; border-top: 3px solid var(--ink); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 20px; font: 500 12px/1.4 var(--mono); color: var(--ink-2); }
  nav { display: flex; gap: 14px; }
  a { text-decoration: none; }
  a:hover { color: var(--accent); }
</style>
