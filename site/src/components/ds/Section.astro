---
/** A numbered datasheet section. Its rule is etched in when it first scrolls into view. */
interface Props { id: string; n: number; title: string }
const { id, n, title } = Astro.props;
---

<section class="ds" id={id} aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}><span class="n">{n}</span><span>{title}</span></h2>
  <slot />
</section>
