---
import Mark from './Mark.astro';
import { PRIMARY_NAV, href, tx, useT, type Lang, type Section } from '../../i18n/ui';
import { getNow } from '../../lib/content';

interface Props { lang: Lang; active?: Section; alternate: string }
const { lang, active, alternate } = Astro.props;
const t = useT(lang);
const l = tx(lang);
const [y, m] = (await getNow()).data.updated.split('-');
const docno = l(`PASLV001 – 1992 – SỬA ĐỔI THÁNG ${m}/${y}`, `PASLV001 – 1992 – REVISED ${y}-${m}`);
const nav = [...PRIMARY_NAV, 'dream'] as const;
---

<header class="top">
  <a class="brand" href={href(lang)} aria-label="Pharaoh Alone">
    <Mark />
    Pharaoh Alone
  </a>
  <span class="right">
    <span class="docno">{docno}</span>
    <nav class="lang" aria-label="Language">
      {(['vi', 'en'] as const).map((code) => (
        <a href={code === lang ? Astro.url.pathname : alternate} hreflang={code} lang={code} aria-current={code === lang ? 'true' : undefined}>
          {code.toUpperCase()}
        </a>
      ))}
    </nav>
  </span>
  <div class="rider" data-rider aria-hidden="true">
    <div class="bot">
      <svg class="on" viewBox="0 0 22 22"><path d="M3 6 H15 V17 H3 Z" /><path d="M5 3.5 H11 M5 19.5 H11" style="stroke-width:2.2" /><path d="M18.5 4 V19" style="stroke:var(--accent);stroke-width:1.8" /></svg>
      <svg class="uav" viewBox="0 0 22 22"><path d="M5 6 L17 16 M17 6 L5 16" /><ellipse cx="4.5" cy="5.5" rx="3.6" ry="1.4" /><ellipse cx="17.5" cy="5.5" rx="3.6" ry="1.4" /><ellipse cx="4.5" cy="16.5" rx="3.6" ry="1.4" /><ellipse cx="17.5" cy="16.5" rx="3.6" ry="1.4" /><rect x="9" y="9" width="4" height="4" style="fill:var(--accent);stroke:none" /></svg>
      <svg viewBox="0 0 22 22"><circle cx="11" cy="3" r="2.4" style="stroke:var(--accent)" /><path d="M7.5 7 H14.5 L13.8 13 H8.2 Z M7.5 7.5 L5.5 13 M14.5 7.5 L16.5 13 M9.5 13 L9 22 M12.5 13 L13 22" /></svg>
    </div>
  </div>
</header>
<nav class="toc" aria-label={t('toc')}>
  {nav.map((s) => <a href={href(lang, s)} aria-current={s === active ? 'page' : undefined}>{s.toUpperCase()}</a>)}
</nav>

<script>
  import '../../scripts/ds/rider';
</script>

<style>
  /* Sticky header strip. Its 3px bottom rule is the track the rider moves along. */
  .top { position: sticky; top: 0; z-index: 10; background: var(--paper); display: flex; align-items: center; justify-content: space-between; gap: 6px 20px; padding-block: 10px 9px; border-bottom: 3px solid var(--ink); }
  .brand { display: flex; align-items: center; gap: 10px; font: 800 15px/1 var(--body); font-stretch: 112%; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; }
  .right { display: flex; align-items: center; gap: 16px; }
  .docno { font: 500 12px/1.2 var(--mono); color: var(--ink-2); }
  .lang { display: flex; border: 1px solid var(--ink); }
  .lang a { font: 600 12px/1 var(--mono); padding: 4px 8px; text-decoration: none; }
  .lang a[aria-current] { background: var(--ink); color: var(--paper); }
  .toc { display: flex; gap: 0 18px; padding-block: 8px; border-bottom: 1px solid var(--rule); overflow-x: auto; scrollbar-width: none; }
  .toc a { font: 600 12.5px/1 var(--body); font-stretch: 110%; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; padding: 6px 0; color: var(--ink-2); transition: color 80ms; white-space: nowrap; }
  .toc a:hover, .toc a[aria-current] { color: var(--accent); }

  .rider { --x: 0px; position: absolute; left: 0; bottom: -3px; width: 100%; height: 0; pointer-events: none; }
  .rider::before { content: ''; position: absolute; left: 0; bottom: 0; height: 3px; width: calc(var(--x) + 9px); background: var(--accent); }
  .bot { position: absolute; bottom: -7.5px; left: 0; width: 18px; height: 18px; transform: translateX(var(--x)); }
  .bot svg { position: absolute; inset: 0; width: 18px; height: 18px; overflow: visible; fill: var(--paper); stroke: var(--ink); stroke-width: 1.4; stroke-linejoin: round; stroke-linecap: round; transition: opacity 200ms, transform 300ms var(--ease); opacity: 0; transform: scale(0.4); }
  .bot svg:global(.on) { opacity: 1; transform: none; }
  .bot .uav:global(.on) { animation: bob 1.4s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(-3px); } }

  @media (max-width: 560px) { .docno { display: none; } }
</style>
