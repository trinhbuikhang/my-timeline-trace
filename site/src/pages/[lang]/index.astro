---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import NowSnapshot from '../../components/home/NowSnapshot.astro';
import SelectedSystems from '../../components/home/SelectedSystems.astro';
import LatestStories from '../../components/home/LatestStories.astro';
import TraceStrip from '../../components/home/TraceStrip.astro';
import SupportLine from '../../components/home/SupportLine.astro';
import { LANGS, type Lang } from '../../i18n/ui';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---

<BaseLayout lang={lang}>
  <Hero lang={lang} />
  <NowSnapshot lang={lang} />
  <SelectedSystems lang={lang} />
  <LatestStories lang={lang} />
  <TraceStrip lang={lang} />
  <SupportLine lang={lang} />
</BaseLayout>
