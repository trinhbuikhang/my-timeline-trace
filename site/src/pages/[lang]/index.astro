---
import D2Layout from '../../layouts/D2Layout.astro';
import home from '../../d2/home.html?raw';
import { localize } from '../../lib/d2';
import { LANGS, type Lang } from '../../i18n/ui';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---

<D2Layout lang={lang} home>
  <Fragment set:html={localize(home, lang)} />
</D2Layout>

<script>
  import '../../d2/entry';
</script>
