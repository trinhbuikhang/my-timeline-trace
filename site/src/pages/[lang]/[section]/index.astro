---
// Temporary page for sections that are not built yet (M2/M3).
import D2Layout from '../../../layouts/D2Layout.astro';
import { LANGS, SECTIONS, href, useT, type Lang, type Section } from '../../../i18n/ui';

export const getStaticPaths = () =>
  LANGS.flatMap((lang) => SECTIONS.filter((s) => s !== 'stories').map((section) => ({ params: { lang, section } })));

const lang = Astro.params.lang as Lang;
const section = Astro.params.section as Section;
const t = useT(lang);
---

<D2Layout lang={lang} title={section.toUpperCase()}>
  <section class="ch on wip">
    <div class="when"><b>{section.toUpperCase()}</b><span>PA-001 · REV —</span></div>
    <h2>{t('wip.title')}</h2>
    <div class="prose"><p>{t('wip.body')}</p></div>
    <p><a class="hand red golink" href={href(lang)}>← {t('wip.back')}</a></p>
  </section>
</D2Layout>

<style>
  .wip { min-height: 62svh; }
</style>
